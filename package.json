{
  "name": "css-view",
  "version": "0.1.0",
  "description": "Capture computed CSS snapshots for any page via agent-browser, CDP, or Playwright",
  "type": "module",
  "license": "ISC",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "keywords": ["agent-browser", "cdp", "cli", "computed-style", "css", "playwright"],
  "files": [
    "bin",
    "docs/css-view.md",
    "docs/developers-guide.md",
    "docs/users-guide.md",
    "src/cli/backend.ts",
    "src/snapshot/*.ts",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "css-view": "./bin/css-view.ts"
  },
  "scripts": {
    "start": "bun run bin/css-view.ts",
    "test": "bun test --max-concurrency=1 src/e2e/__tests__ && bun test --max-concurrency=1 src/cli/__tests__ && bun test --max-concurrency=1 src/snapshot/__tests__",
    "lint": "bunx @biomejs/biome check .",
    "fmt": "bunx @biomejs/biome format --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leynos/css-view.git"
  },
  "homepage": "https://github.com/leynos/css-view#readme",
  "bugs": {
    "url": "https://github.com/leynos/css-view/issues"
  },
  "author": "Payton McIntosh <pmcintosh@df12.net>",
  "dependencies": {
    "commander": "^11.1.0",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.2",
    "@types/bun": "^1.3.11"
  }
}
