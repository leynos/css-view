{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["@types/bun"],
    "outDir": "dist"
  },
  "include": ["src", "bin", "scripts"],
  "exclude": ["dist", "node_modules"]
}
